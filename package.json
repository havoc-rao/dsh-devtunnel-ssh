{
  "name": "dsh-devtunnel-ssh",
  "version": "0.0.1-experimental",
  "description": "Experimental independent Dev Tunnel SSH carrier plugin; manual first, ordinary workspace integration gated",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client/client.js", "./package.json": "./package.json" },
  "icon": "./icon.svg",
  "files": ["lib", "cordis.patch.yml", "README.md", "MANUAL.md", "icon.svg"],
  "dependencies": { "@deepseek-ai/schemastery": "^3.18.2" },
  "peerDependencies": { "dsh-remote": "*", "@deepseek-ai/cordis": "^4.0.1" },
  "peerDependenciesMeta": { "dsh-remote": { "optional": true } },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-primitives"]
    }
  },
  "scripts": { "test": "node --test test/*.test.mjs" }
}
